{
  "name": "distributed-job-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A learning project for a distributed job scheduling and execution system.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "pg": "^8.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@types/supertest": "^6.0.3",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
