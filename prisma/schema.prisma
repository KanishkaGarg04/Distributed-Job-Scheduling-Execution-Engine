generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum JobType {
  REPORT_GENERATE @map("report.generate")
  DATA_PROCESS    @map("data.process")
}

enum JobStatus {
  PENDING
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
}

model Job {
  id           String          @id @default(uuid()) @db.Uuid
  type         JobType
  payload      Json
  result       Json?
  status       JobStatus       @default(PENDING)
  priority     Int             @default(5)
  delaySeconds Int             @default(0)
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  executions   JobExecution[]

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model JobExecution {
  id            String          @id @default(uuid()) @db.Uuid
  jobId         String          @db.Uuid
  attemptNumber Int
  status        ExecutionStatus @default(STARTED)
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  errorMessage  String?
  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt])
}
